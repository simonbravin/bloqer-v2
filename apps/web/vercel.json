{
  "functions": {
    "app/**/*.{js,ts}": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/operational-alerts",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/scheduled-reports",
      "schedule": "5 5 * * *"
    },
    {
      "path": "/api/cron/notification-digest",
      "schedule": "5 10 * * *"
    }
  ]
}
