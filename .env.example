# ─────────────────────────────────────────────────────────────────────────────
# Bloqer 2.0 — Environment Variables
# Copy this file to .env.local (Next.js) and/or .env in this same folder (repo root).
# Prisma CLI (`pnpm db:migrate`, `db:migrate:deploy`, `db:generate`, `db:seed`) loads **.env** here via dotenv-cli.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Database (PostgreSQL / Neon) ─────────────────────────────────────────────
# Required before any DB operation (Phase 1+)
# Local: Neon project bloqer-v2, branch `dev` (pooled DATABASE_URL + direct DIRECT_URL).
# Production: Neon project bloqer-v2, branch `production` (compute ep-cold-mouse-appkpn84).
# Do not point local .env at production. Seed / migrate dev / db push refuse that host
# unless BLOQER_ALLOW_PRODUCTION_DB=I_UNDERSTAND_THIS_IS_PRODUCTION.
DATABASE_URL=""
DIRECT_URL=""

# ── Auth (Auth.js v5) ─────────────────────────────────────────────────────────
# AUTH_SECRET: required. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL: optional in dev (auto-detected). Set in production.
AUTH_URL=""
# Public base URL for emails / invitations (first valid wins with AUTH_URL):
NEXT_PUBLIC_APP_URL=""
APP_URL=""
# Google OAuth: create at console.cloud.google.com
# Optional for local dev (app boots but OAuth login fails without them)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Optional for app boot — both required together to send mail (see isEmailConfigured()).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
# Optional for app boot — all non-empty R2_* (except optional R2_PUBLIC_URL) required for uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── Cron (operational alerts + scheduled reports) ─────────────────────────────
# Min 16 chars. If unset/short, /api/cron/operational-alerts and /api/cron/scheduled-reports return 503.
CRON_SECRET=""

# ── Bloqer AI (optional; provider-agnostic) — EXPERIMENTAL LOCAL ──────────────
# Default OFF. Missing/empty/false → AI disabled (no UI, no /api/ai/chat, no provider).
BLOQER_AI_ENABLED=false
# Production-like defense: even if BLOQER_AI_ENABLED=true, also need ALLOW when any of:
#   VERCEL_ENV=production | APP_ENV=production | NODE_ENV=production
# (covers portal, Vercel Preview with NODE_ENV=production, and `next start`).
# Leave ALLOW unset for portal until intentionally enabled.
BLOQER_AI_ALLOW_PRODUCTION=
# Provider id registered in @bloqer/ai (MVP adapter: openai).
BLOQER_AI_PROVIDER=openai
BLOQER_AI_MODEL=gpt-4.1-mini
BLOQER_AI_TIMEOUT_MS=60000
BLOQER_AI_MAX_TOOL_CALLS=10
BLOQER_AI_MAX_OUTPUT_TOKENS=2048
# Optional OpenAI-compatible base URL (OpenRouter/Groq/local, etc.).
# Invalid URL is ignored (does not wipe OPENAI_API_KEY).
BLOQER_AI_BASE_URL=
# Credentials for the selected provider (only keys for implemented adapters).
# Never commit real keys. Placeholder only:
OPENAI_API_KEY=

# ── Seed (db:seed only; not required for app runtime) ─────────────────────────
SEED_USER_EMAIL=you@example.com
# Optional: sets bcrypt password + emailVerified on the seed user (local/docs capture only).
SEED_USER_PASSWORD=

# Guide screenshots dataset (run: DOCS_DEMO_SEED=1 pnpm db:seed)
DOCS_DEMO_SEED=
DOCS_USER_EMAIL=docs-guide@bloqer.demo
DOCS_USER_PASSWORD=
DOCS_BASE_URL=http://localhost:3000
# Optional overrides when demo tenant already has data:
DOCS_PROJECT_ID=
DOCS_PO_ID=
DOCS_BUDGET_ID=
DOCS_ACCOUNT_ID=
DOCS_RECONCILIATION_ID=
DOCS_RECONCILIATION_CLOSE_ID=
DOCS_CERTIFICATION_ID=
DOCS_SALES_INVOICE_ID=
DOCS_JOBSITE_LOG_ID=
DOCS_SUBCONTRACT_ID=
DOCS_SUBCONTRACT_CERT_ID=
# Optional: override deterministic invite token used only for /invitaciones/aceptar capture.
# Never commit real tokens. Default is derived locally in seed/capture helpers.
DOCS_INVITATION_TOKEN=
DOCS_ALLOW_REAL_TENANT=

